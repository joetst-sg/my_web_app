# Copy to .env.local for local development. Never commit .env.local.
# In Vercel, add the same variables under Settings → Environment Variables.

# --- Required -------------------------------------------------------------
# Supabase project URL and publishable ("anon") key: Supabase dashboard →
# Project Settings → API. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Public URL of the site (used for canonical URLs, sitemap, emails, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: email delivery ----------------------------------------------
# Server-only secret key. Used ONLY by /api/cron/email-outbox to read the
# email queue. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Resend API key (https://resend.com). Without it, production emails stay
# queued and development prints them to the console.
EMAIL_PROVIDER_API_KEY=
# Optional: "resend" or "console" (auto-detected when unset).
EMAIL_PROVIDER=
EMAIL_FROM=Loupe <notifications@yourdomain.com>
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Optional: analytics -----------------------------------------------------
# Reserved for an external analytics provider. First-party analytics
# (analytics_events table) work without it.
ANALYTICS_KEY=

# --- Development / tooling only (never set in Vercel) -----------------------
# Personal access token for scripts (db:seed, db:types). Alternatively put it
# in ~/.supabase/access-token. Create at supabase.com/dashboard/account/tokens.
SUPABASE_ACCESS_TOKEN=
# Integration test accounts (defaults to DEMO_ACCOUNTS.local.md).
# TEST_SELLER1_EMAIL= / TEST_SELLER1_PASSWORD= etc.
