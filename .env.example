# Copy to .env.local for local development. Never commit .env.local.
# In Vercel, add the same variables under Settings → Environment Variables.

# --- Required -------------------------------------------------------------
# Supabase project URL and publishable ("anon") key: Supabase dashboard →
# Project Settings → API. Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Public URL of the site (used for canonical URLs, sitemap, emails, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: email delivery ----------------------------------------------
# Server-only secret key. Used ONLY by /api/cron/email-outbox to read the
# email queue. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Resend API key (https://resend.com). Without it, production emails stay
# queued and development prints them to the console.
EMAIL_PROVIDER_API_KEY=
# Optional: "resend" or "console" (auto-detected when unset).
EMAIL_PROVIDER=
EMAIL_FROM=Loupe <notifications@yourdomain.com>
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Optional: analytics -----------------------------------------------------
# Reserved for an external analytics provider. First-party analytics
# (analytics_events table) work without it.
ANALYTICS_KEY=

# --- Development / tooling only (never set in Vercel) -----------------------
# Personal access token for scripts (db:seed, db:types). Alternatively put it
# in ~/.supabase/access-token. Create at supabase.com/dashboard/account/tokens.
SUPABASE_ACCESS_TOKEN=
# Integration test accounts (defaults to DEMO_ACCOUNTS.local.md).
# TEST_SELLER1_EMAIL= / TEST_SELLER1_PASSWORD= etc.

# --- GREEN FUNDING import (server-side only; never prefix with NEXT_PUBLIC_) ---
# "test" imports and translates but can never publish. Switch to "production"
# only after the review workflow has been tested.
GREEN_FUNDING_IMPORT_MODE=test
# true = publish each product as soon as its translation is ready (production
# mode only; the same URL/title/status checks apply). false = wait for review.
GREEN_FUNDING_AUTO_PUBLISH=false
# Data source implementation: "html" (authorized public pages). An official
# API/feed can be added as another source without changing the rest.
GREEN_FUNDING_SOURCE=html
GREEN_FUNDING_API_KEY=
GREEN_FUNDING_BASE_URL=https://greenfunding.jp
# Minutes between automatic syncs (the database scheduler ticks every 5 min).
GREEN_FUNDING_SYNC_INTERVAL_MINUTES=30
# Buy Now URLs must be on one of these hosts (comma-separated, exact match).
GREEN_FUNDING_ALLOWED_DOMAINS=greenfunding.jp,www.greenfunding.jp
GREEN_FUNDING_IMAGE_DOMAINS=images.greenfunding.jp
GREEN_FUNDING_MAX_REQUESTS_PER_RUN=50
GREEN_FUNDING_REQUEST_DELAY_MS=500
GREEN_FUNDING_TIMEOUT_MS=30000
# Newest-campaign listing pages read per sync (12 campaigns per page).
GREEN_FUNDING_DISCOVERY_PAGES=1
# Imported campaigns re-checked for updates per sync.
GREEN_FUNDING_UPDATE_CHECKS_PER_RUN=10
GREEN_FUNDING_MAX_IMAGES=10
# Length (characters) of the automatic Japanese summary (introduction + key
# features, no support plans or prices). Only the title, short description and
# this summary are translated — not the full campaign page.
GREEN_FUNDING_SUMMARY_CHARS=400
# GREEN FUNDING category names never imported, comma-separated (e.g. アイドル,イベント).
GREEN_FUNDING_EXCLUDED_CATEGORIES=
# Turn GREEN FUNDING imports off without removing the settings.
GREEN_FUNDING_ENABLED=true
# Most new campaigns imported per run (the rest wait for the next run).
GREEN_FUNDING_MAX_NEW_PER_RUN=12

# --- Indiegogo (official public API, no key needed) --------------------------
# Off until set to true. Only tech/innovation products are imported (the AI
# decides), so AI_PROVIDER and AI_API_KEY must be set as well.
INDIEGOGO_ENABLED=false
# Once a day.
INDIEGOGO_SYNC_INTERVAL_MINUTES=1440
# Only campaigns that started within this many days are considered.
INDIEGOGO_LOOKBACK_DAYS=90
# Only campaigns that have already raised at least this many US dollars
# (other currencies converted with approximate rates; 0 = no minimum).
INDIEGOGO_MIN_RAISED_USD=50000
# Optional rate overrides, e.g. HKD=0.128,EUR=1.10
INDIEGOGO_USD_RATES=
INDIEGOGO_MAX_NEW_PER_RUN=8
INDIEGOGO_MIN_BACKERS=0
INDIEGOGO_MAX_REQUESTS_PER_RUN=20
INDIEGOGO_REQUEST_DELAY_MS=1000
INDIEGOGO_API_BASE_URL=https://www.indiegogo.com
INDIEGOGO_ALLOWED_DOMAINS=www.indiegogo.com,indiegogo.com
INDIEGOGO_IMAGE_DOMAINS=cdn.images.indiegogo.com

# --- AI writer (English summary + Traditional Chinese) -----------------------
# Server-only. When set, the AI writes every product's English summary,
# SEO text and tags, then translates them into Traditional Chinese.
# Without it, GREEN FUNDING falls back to machine translation and Indiegogo
# imports wait. Key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash

# --- Translation (Japanese → English + Traditional Chinese) ---
# "google" (Google Cloud Translation Basic; first 500k characters/month free),
# "azure" (Microsoft Azure AI Translator; free F0 tier ≈ 2M characters/month)
# or "anthropic" (Claude; paid, rewrites into shop-style copy incl. SEO text).
TRANSLATION_PROVIDER=google
# Google: an API key restricted to the Cloud Translation API.
# Azure: "KEY 1" of the Translator resource. Anthropic: an sk-ant-… API key.
TRANSLATION_API_KEY=
# Azure only: the resource's "Location/Region" (e.g. eastasia).
AZURE_TRANSLATOR_REGION=
# Azure only, optional: custom endpoint (default https://api.cognitive.microsofttranslator.com).
AZURE_TRANSLATOR_ENDPOINT=
# Anthropic only.
TRANSLATION_MODEL=claude-sonnet-5-5
TRANSLATION_MAX_RETRIES=3
# Translation jobs processed per scheduler tick (each makes two AI requests).
TRANSLATION_JOBS_PER_RUN=2
